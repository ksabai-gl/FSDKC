APP_NAME=Klearcom
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=klearcom
DB_USERNAME=klearcom
DB_PASSWORD=secret

MONGODB_URI=mongodb://127.0.0.1:27017/klearcom

# Platform auth — set true in production; false for local demo without tokens
KLEARCOM_AUTH_ENABLED=false

# Comma-separated browser origins allowed to call the API (no wildcard in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1:5173

KLEARCOM_ALERT_THRESHOLD_PCT=90
KLEARCOM_RECENT_CHECK_WINDOW=20
KLEARCOM_KPI_WINDOW_DAYS=30
