# Docker Compose Environment Variables
# Copy this file to .env in the project root before running docker compose
# Do NOT commit .env to version control

# Application
APP_ENV=local
APP_DEBUG=true

# Database Credentials (REQUIRED)
DB_DATABASE=klearcom
DB_USERNAME=klearcom
DB_PASSWORD=your_secure_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here

# MongoDB
MONGODB_URI=mongodb://mongodb:27017/klearcom

# CORS - comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Frontend
VITE_API_URL=http://localhost:8080/api

# Port overrides (optional - uncomment to change defaults)
# MARIADB_PORT=3306
# MONGODB_PORT=27017
